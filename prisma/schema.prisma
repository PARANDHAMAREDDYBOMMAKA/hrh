// HRH - Hotels/Hostels-Restaurants Hub
// Restaurant owner ties up with hostels/hotels, uploads menu,
// customers at hostels scan QR to order meals (breakfast/dinner batch model)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ──────────────────────────────────────────────

enum UserRole {
  ADMIN
  PARTNER
  CUSTOMER
  CRM_OWNER
  SALES_MANAGER
  SALES_REP
}

enum SlotType {
  BREAKFAST
  DINNER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum CrmNoteType {
  GENERAL
  COMPLAINT
  FEEDBACK
  MEETING
  PAYMENT
}

// ─── PARTNER (Hostel/Hotel) ─────────────────────────────

model Partner {
  id             String   @id @default(cuid())
  name           String
  address        String
  city           String   @default("")
  contactPerson  String
  phone          String
  email          String?
  commissionRate Float    @default(10)
  qrCodeUrl      String?
  isActive       Boolean  @default(true)
  contractStart  DateTime @default(now())
  contractEnd    DateTime?
  totalRooms     Int      @default(0)
  logoUrl        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders   Order[]
  users    User[]
  crmNotes CrmNote[]
  payouts  Payout[]

  @@index([isActive])
  @@index([city])
}

// ─── MENU ───────────────────────────────────────────────

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  imageUrl    String?
  isVeg       Boolean  @default(true)
  isAvailable Boolean  @default(true)
  slotType    SlotType
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slotType, isAvailable])
}

// ─── ORDERS ─────────────────────────────────────────────

model Order {
  id               String      @id @default(cuid())
  orderNumber      String      @unique @default(cuid())
  partnerId        String
  customerId       String?
  customerName     String      @default("")
  customerPhone    String      @default("")
  trackingToken    String?     @unique @default(cuid())
  roomNumber       String
  deliveryNotes    String?
  items            Json
  totalAmount      Float
  deliverySlot     SlotType
  status           OrderStatus @default(PENDING)
  commissionAmount Float
  orderDate        DateTime    @default(now())
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  partner  Partner @relation(fields: [partnerId], references: [id])
  customer User?   @relation(fields: [customerId], references: [id])

  @@index([partnerId, status])
  @@index([customerId, createdAt])
  @@index([deliverySlot, status])
  @@index([orderDate])
  @@index([orderNumber])
}

// ─── USERS & AUTH ───────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  phone         String?
  name          String
  role          UserRole  @default(CUSTOMER)
  partnerId     String?
  isVerified       Boolean   @default(false)
  mustChangePassword Boolean  @default(false)
  emailVerified    DateTime?
  image            String?
  lastLogin        DateTime?
  loginCount       Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  partner         Partner?         @relation(fields: [partnerId], references: [id])
  orders          Order[]
  customerProfile CustomerProfile?
  accounts        Account[]
  sessions        Session[]

  ownedCrmLeads         CrmLead[]        @relation("CrmLeadOwner")
  ownedCrmAccounts      CrmAccount[]     @relation("CrmAccountOwner")
  ownedCrmContacts      CrmContact[]     @relation("CrmContactOwner")
  ownedCrmOpportunities CrmOpportunity[] @relation("CrmOpportunityOwner")
  crmActivities         CrmActivity[]    @relation("CrmActivityOwner")
  assignedCrmTasks      CrmTask[]        @relation("CrmTaskAssignee")

  @@index([role])
  @@index([partnerId])
}

model CustomerProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  defaultPartnerId  String?
  defaultRoomNumber String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── TIME SLOTS ─────────────────────────────────────────

model TimeSlot {
  id              String   @id @default(cuid())
  name            String
  slotType        SlotType @unique
  orderCutoffTime String   // "07:00"
  deliveryTime    String   // "09:00"
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── CRM ────────────────────────────────────────────────

model CrmNote {
  id        String      @id @default(cuid())
  partnerId String
  type      CrmNoteType @default(GENERAL)
  title     String
  content   String
  createdBy String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, type])
  @@index([createdAt])
}

model Payout {
  id          String   @id @default(cuid())
  partnerId   String
  amount      Float
  period      String   // "2026-04" (year-month)
  orderCount  Int
  isPaid      Boolean  @default(false)
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, period])
  @@index([isPaid])
}

// ─── AUDIT LOG ──────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userEmail  String?
  userRole   String?
  action     String
  entityType String?
  entityId   String?
  method     String
  path       String
  ipAddress  String
  userAgent  String?
  status     String   @default("SUCCESS")
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
}

// ─── NEXTAUTH MODELS ────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── CRM MODULE ─────────────────────────────────────────

enum CrmLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum CrmLeadSource {
  WEBSITE
  REFERRAL
  COLD_CALL
  EVENT
  PARTNER
  OTHER
}

enum CrmStage {
  PROSPECTING
  QUALIFICATION
  NEEDS_ANALYSIS
  VALUE_PROPOSITION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum CrmActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
}

enum CrmTaskStatus {
  OPEN
  DONE
}

enum CrmTaskPriority {
  LOW
  MEDIUM
  HIGH
}

model CrmLead {
  id             String        @id @default(cuid())
  name           String
  company        String?
  email          String?
  phone          String?
  title          String?
  source         CrmLeadSource @default(OTHER)
  status         CrmLeadStatus @default(NEW)
  estimatedValue Float?
  notes          String?
  ownerId        String
  convertedAt        DateTime?
  convertedAccountId String?
  convertedContactId String?
  convertedOppId     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  owner      User          @relation("CrmLeadOwner", fields: [ownerId], references: [id])
  activities CrmActivity[]
  tasks      CrmTask[]

  @@index([status])
  @@index([ownerId])
  @@index([createdAt])
}

model CrmAccount {
  id              String   @id @default(cuid())
  name            String
  industry        String?
  website         String?
  phone           String?
  email           String?
  address         String?
  city            String?
  notes           String?
  ownerId         String
  sourcePartnerId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner         User             @relation("CrmAccountOwner", fields: [ownerId], references: [id])
  contacts      CrmContact[]
  opportunities CrmOpportunity[]
  activities    CrmActivity[]
  tasks         CrmTask[]

  @@index([ownerId])
  @@index([name])
}

model CrmContact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  title     String?
  accountId String?
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner         User             @relation("CrmContactOwner", fields: [ownerId], references: [id])
  account       CrmAccount?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  opportunities CrmOpportunity[]
  activities    CrmActivity[]
  tasks         CrmTask[]

  @@index([ownerId])
  @@index([accountId])
}

model CrmOpportunity {
  id                 String    @id @default(cuid())
  name               String
  stage              CrmStage  @default(PROSPECTING)
  amount             Float     @default(0)
  probability        Int       @default(10)
  expectedCloseDate  DateTime?
  notes              String?
  accountId          String
  contactId          String?
  ownerId            String
  closedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  owner      User          @relation("CrmOpportunityOwner", fields: [ownerId], references: [id])
  account    CrmAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact    CrmContact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  activities CrmActivity[]
  tasks      CrmTask[]

  @@index([stage])
  @@index([ownerId])
  @@index([accountId])
}

model CrmActivity {
  id            String          @id @default(cuid())
  type          CrmActivityType @default(NOTE)
  subject       String
  body          String?
  ownerId       String
  leadId        String?
  accountId     String?
  contactId     String?
  opportunityId String?
  occurredAt    DateTime        @default(now())
  createdAt     DateTime        @default(now())

  owner       User            @relation("CrmActivityOwner", fields: [ownerId], references: [id])
  lead        CrmLead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  account     CrmAccount?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact     CrmContact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  opportunity CrmOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([occurredAt])
  @@index([leadId])
  @@index([accountId])
  @@index([opportunityId])
}

model CrmTask {
  id            String          @id @default(cuid())
  title         String
  description   String?
  dueDate       DateTime?
  status        CrmTaskStatus   @default(OPEN)
  priority      CrmTaskPriority @default(MEDIUM)
  assigneeId    String
  leadId        String?
  accountId     String?
  contactId     String?
  opportunityId String?
  completedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  assignee    User            @relation("CrmTaskAssignee", fields: [assigneeId], references: [id])
  lead        CrmLead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  account     CrmAccount?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact     CrmContact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  opportunity CrmOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([assigneeId, status])
  @@index([dueDate])
}
